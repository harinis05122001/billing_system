# Copy this file to .env and adjust as needed. Every variable below has a
# safe default baked into config/settings.py, so the app runs without a
# .env file at all for local evaluation -- these are here for when you want
# to override something (e.g. to send real email).

# --- Core ---
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# --- Database ---
# Defaults to SQLite (db.sqlite3 in the project root). Uncomment to use
# Postgres/MySQL/etc instead:
# DATABASE_URL=postgres://user:password@localhost:5432/billing_system

# --- Email ---
# Defaults to the console backend, which just prints emails to the terminal
# -- nothing to configure for local evaluation. To send real email via SMTP
# (e.g. Gmail with an App Password, SendGrid, Mailgun, ...), set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Billing System <billing@example.com>

# --- Celery / Redis ---
# Redis is the Celery broker. Run `docker compose up -d` for a one-command
# local Redis, or point this at any reachable Redis instance.
CELERY_BROKER_URL=redis://localhost:6379/0
